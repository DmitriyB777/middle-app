# Скопируйте этот файл в .env:
#     cp .env.example .env
# Значения из реального окружения имеют приоритет над .env.

# Полная строка подключения. Если задана, переменные DB_* игнорируются.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Параметры подключения по частям (используются, если DATABASE_URL не задан).
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=flask-backend-middle-db

# Обязательно. Сгенерируйте так:
#     python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me
